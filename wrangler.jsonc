// Cloudflare Workers static-assets deployment of the built site (dist/). Free plan: unlimited requests to static
// assets, up to 20,000 files and 25 MiB per file. Cloudflare's Git integration runs `npm run build` then
// `npx wrangler deploy`. Security and cross-origin-isolation headers come from public/_headers (copied into dist/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vivofold-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Prerendered pages live at route/index.html; /about redirects to /about/ like on GitHub Pages.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
