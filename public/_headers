  Cross-Origin-Embedder-Policy: credentialless

# Scripts and data loaded by Workbench workers must also carry COEP, or isolated pages refuse to start the worker.
# (A COEP header on a script response has no effect on the non-isolated public pages that load it.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
/rdkit/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
/wasm/*
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
/data/*
  Cross-Origin-Resource-Policy: same-origin
